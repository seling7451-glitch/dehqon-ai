{
  "expo": {
    "name": "Dehqon AI",
    "slug": "dehqon-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dehqon-ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "uz.dehqonai.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "backgroundColor": "#f6f8f1",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "10787ea5-4299-4987-a746-cd4aab20582a"
      }
    },
    "owner": "xumoyun710"
  }
}