<style type="text/css">BODY{scrollbar-base-color:scrollbar;scrollbar-highlight-color:white;scrollbar-darkshadow-color:scrollbar;scrollbar-shadow-color:white;}#divCont DIV{border:none;white-space:normal;}#divCont IMG{float:none;vertical-align:middle;}#divCont A{text-decoration:none;}#divCont A:link{color:#008080;}#divCont A:visited{color:#008080;}#divCont A:hover{color:#ff0000;}#divCont P{margin:0px;padding:0px;line-height:1.0;}#divCont LABEL{display:none;}.aExp{text-align:left;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:normal;color:red;font-weight:600;font-size:12pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.aOAD{width:100%;text-align:right;text-indent:0px;margin:0pt 0pt 12pt 0pt;font-style:italic;color:#808080;font-weight:400;font-size:10pt;font-family:"Times New Roman";font-variant:normal;line-height:1.0;}.signCont{text-align:center;margin:0pt 0pt 12pt 0px;text-indent:0pt;}.mrkup{background-color:#00008B!important;color:#FFFFFF!important;}.mrkupNav{color:#00008B!important;}.mrkupNav SPAN{font:12px Webdings!important;padding:0px 2px!important;}.iorRN{font-weight:600;}.iorVal{text-indent:0px;margin-left:1px;}.clausePrfx{display:inline;float:left;}.clauseSuff{display:block;width:100%;text-indent:0px;}@media print{.clausePrfx{float:none;}.clauseSuff{display:inline;width:auto;}}.ACCEPTING_BODY{text-align:center; text-indent:0; margin:0 0 0 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman";font-variant:normal; line-height:normal;text-transform:uppercase;}.ACT_ESSENTIAL_ELEMENTS{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.ACT_ESSENTIAL_ELEMENTS_NUM{text-align:center; text-indent:0; margin:0 70% 0 0; font-style:normal; color:#000000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;padding-bottom: 20px;}.ACT_FORM{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_FORM_LAW{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TEXT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.ACT_TITLE{text-align:center; text-indent:0; margin:12pt 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; text-transform:uppercase; font-variant:normal; line-height:normal;}.ACT_TITLE_APPL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 10pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_LANDSCAPE_TITLE{text-align:center; text-indent:0pt; margin:10pt 0pt 12pt 66%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TEXT{text-align:center; text-indent:0pt; margin:0pt 0pt 0pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.APPL_BANNER_PORTRAIT_TITLE{text-align:center; text-indent:0pt; margin:0pt 0pt 12pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.BY_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:0; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CHANGES_ORIGINS{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.CLAUSE_AFTER_SRC{text-align:justify;text-justify:inter-word; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:boldl; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.CLAUSE_DEFAULT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.COMMENT_FOR_WARNING{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:italic; color:#800080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.DEPARTMENTAL{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.EXPLANATION{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:3pt 0 3pt 0; font-style:normal; color:#993366; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; line-height:normal;}.EXTRACT{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.FOOTNOTE{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#339966; font-weight:normal; font-size:10pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.GRIF_PARLAMENT{text-align: left; text-indent:0 mm; margin:0 0 3pt 50%; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.INDEXES_ON_REF{text-align:left;text-indent:0cm;margin:3pt 0.9cm 3pt 0.95cm;font-style:normal;color:#008000;font-weight:normal;font-size:11pt;font-family:"Times New Roman"; font-variant:normal;line-height:1.0;}.IS_TABLE_FOR_LIST_TEMP{text-align:justify;text-justify:inter-word; text-indent:15mm; margin:0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:1.3;}.NEW_EDITION{text-align:center; text-indent:0; margin:0 0 6pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; text-transform:lowercase; font-variant:normal; line-height:normal;}.OFFICIAL_SOUR_TEXT{text-align:right; font-size:8pt; font-family:Arial, Helvetica, sans-serif; border: 1px solid #A9DBFC; background-color: #E6EDFF;}.PUBLICATION_ORIGIN{text-align:center; text-indent:0; margin:0 0 12pt 0; font-style:italic; color:#800000; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.SIGNATURE_STAMPS_PLACEHOLDER{text-align:justify; text-justify:inter-word; text-indent:0; margin:4 10; vertical-align:text-top; flow:left;}.SIGNATURE_STAMP_TEXT{text-align:center; text-indent:0; margin:0; font-style:normal; color:#000080; font-weight:normal; font-size:11pt; font-family:"Times New Roman"; font-variant:normal; vertical-align:baseline!important;}.SIGNATURE_WITH_BOLD{text-align:right; text-indent:0; margin:6pt 0 6pt 0; font-style:normal; color:#000000; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TABLE_STD{background:#ffffff;color:#000000;margin:4pt;font-size:12pt;width:100%;height:100%;overflow:visible;}.TEXT_15_LEFT{text-align: left; text-indent:30 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_30_LEFT{text-align: left; text-indent:45 mm; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD{text-align:justify;  text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;text-indent:15mm;}.TEXT_BOLD_CENTER{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_BOLD_RIGHT{text-align:right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000000; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_CENTER{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_AFTER_SRC{text-align:center; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_HEADER_DEFAULT{text-align:center; text-indent:0; margin:6pt 0 3pt 0; font-style:normal; color:#000080; font-weight:bold; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}.TEXT_ITALIC{text-align:justify; text-indent:0; margin:0; font-style:italic; color:#000080; font-weight:italic; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal; text-indent:15mm}.TEXT_RIGHT{text-align: right; text-indent:0; margin:0 0 3pt 0; font-style:normal; color:#000080; font-weight:normal; font-size:12pt; font-family:"Times New Roman"; font-variant:normal; line-height:normal;}DIV#theSysCssID TABLE{background-color:ivory;color:#000000;border-collapse:separate;font:x-small Tahoma;table-layout:auto;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theSysCssID TABLE TD,TH{border:1px solid #000000;cursor:auto;min-height:8pt;padding:1px 1px 1px 2px;vertical-align:top;white-space:normal;word-wrap:break-word;display:block!important;visibility:visible!important;}DIV#theNormCssID TABLE{background-color:#f5f5f5;color:red;border:1px solid red;font:small Verdana;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNormCssID TABLE TD,TH{border:1px solid red;cursor:auto;min-height:8pt;padding:2px 2px 2px 3px;vertical-align:top;white-space:normal;word-wrap:normal;display:block!important;visibility:visible!important;}DIV#theDefCssID TABLE{background-color:#ffffff;color:#000000;border:1px solid #000000;border-collapse:collapse;font:normal normal normal small/normal Times New Roman;table-layout:fixed;text-align:left;text-decoration:none;text-indent:0;text-transform:none;width:100%;word-spacing:normal;position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theDefCssID TABLE TD,TH{background-color:#ffffff;color:#000000;border:1px solid #000000;cursor:auto!important;font:normal normal normal small/normal Times New Roman;min-height:8pt;padding:1px 1px 1px 2px;text-align:left;text-decoration:none;text-indent:0;text-transform:none;vertical-align:top;white-space:normal;word-wrap:break-word;word-spacing:normal;display:block!important;visibility:visible!important;}DIV#theNotCssID TABLE{position:relative;margin:0pt;top:0pt;zoom:normal;z-index:auto;}DIV#theNotCssID TABLE TD,TH,CAPTION{display:block!important;visibility:visible!important;}A#tabBoxDisable TABLE TD,TH{color:#808080;border-color:#808080;}.tabBox{display:inline-block;} .OFFICIAL_SOUR_TEXT{display:none;}</style>
</head>
<body lang='uz-Latn-UZ'><div class=WordSection1>
﻿<div id="divCont" style="background:#ffffff;border:none;margin:auto;"><div class="ACCEPTING_BODY"><div name="-6315937" id="-6315937">Oʻzbekiston Respublikasi Vazirlar Mahkamasining</div></div><div class="ACT_FORM"><div name="-6315938" id="-6315938">qarori</div></div><div class="ACT_TITLE"><div name="-6315958" id="-6315958">Qishloq xoʻjaligi mahsulotlarini yetishtiruvchilarga subsidiya berish axborot tizimini joriy qilish chora-tadbirlari toʻgʻrisida</div></div><div class="BY_DEFAULT"><div name="-6315960" id="-6315960"></div></div><div class="ACT_TEXT"><div name="-6315997" id="-6315997">Oʻzbekiston Respublikasi Prezidentining “Raqamli Oʻzbekiston — 2030” strategiyasini tasdiqlash va uni samarali amalga oshirish chora-tadbirlari toʻgʻrisida” 2020-yil 5-oktabrdagi PF-6079-son <a href="https://lex.uz/ru/docs/-5030957">Farmoni</a> ijrosini taʼminlash, shuningdek, qishloq xoʻjaligi mahsulotlari yetishtiruvchilarni davlat tomonidan qoʻllab-quvvatlash hamda subsidiya berish jarayonlarini toʻliq avtomatlashtirish maqsadida Vazirlar Mahkamasi qaror qiladi:</div></div><div class="ACT_TEXT"><div name="-6315999" id="-6315999">1. Quyidagilar:</div></div><div class="ACT_TEXT"><div name="-6316003" id="-6316003">Oʻzbekiston Respublikasi Prezidentining 2020-yil 5-oktabrdagi PF-6079-son Farmoni bilan tasdiqlangan “Raqamli Oʻzbekiston — 2030” strategiyasi doirasida 2020 — 2022-yillarda qishloq, suv va oʻrmon xoʻjaligi sohalarini raqamli transformatsiya qilish <a href="https://lex.uz/ru/docs/-5030957#-5037441">dasturida</a> qishloq xoʻjaligi mahsulotlarini yetishtiruvchilarga subsidiyalar berish boʻyicha materiallarni toʻplash, koʻrib chiqish va vakolatli organlar va tashkilotlar bilan kelishishning yagona axborot tizimini joriy qilish vazifasi nazarda tutilganligi;</div></div><div class="ACT_TEXT"><div name="-6316006" id="-6316006">yuqoridagi vazifa ijrosi yuzasidan Qishloq xoʻjaligi vazirligi tomonidan qishloq xoʻjaligi mahsulotlari yetishtiruvchilarni davlat tomonidan qoʻllab-quvvatlash va subsidiya berish jarayonlarini toʻliq avtomatlashtirishga qaratilgan “Qishloq xoʻjaligi mahsulotlarini yetishtiruvchilarga subsidiya berish” axborot tizimi (keyingi oʻrinlarda — “Agrosubsidiya” axborot tizimi) ishlab chiqilganligi maʼlumot uchun qabul qilinsin.</div></div><div class="ACT_TEXT"><div name="-6316009" id="-6316009">2. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi “Agrosubsidiya” axborot tizimi xizmatlarini kengaytirish, ushbu tizim orqali davlat boshqaruvi organlari va xoʻjalik birlashmalari tomonidan subsidiyalash xizmatlari oʻz vaqtida koʻrsatilishi yuzasidan nazorat olib boradigan, mazkur tizim boʻyicha ishlarni muvofiqlashtiradigan masʼul davlat organi etib belgilansin.</div></div><div class="BY_DEFAULT"><div name="-6316011" id="-6316011"></div></div><div class="BY_DEFAULT"><div name="-6561449" id="-6561449"></div></div><div class="ACT_TEXT"><div name="-6561452" id="-6561452">3. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi huzuridagi “Agrosanoatni raqamlashtirish markazi” MCHJ “Agrosubsidiya” axborot tizimining operatori etib belgilansin va unga quyidagi qoʻshimcha vazifalar yuklansin:</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6561457" id="-6561457">(3-bandning birinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 3-avgustdagi 330-sonli <a href="https://lex.uz/ru/docs/-6556006?ONDATE=04.08.2023 00#-6558075">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 04.08.2023-y., 09/23/330/0559-son)</div></div><div class="ACT_TEXT"><div name="-6316014" id="-6316014">“Agrosubsidiya” axborot tizimiga kirish va tizimda ishlashda undan foydalanuvchilarga amaliy yordam koʻrsatish;</div></div><div class="ACT_TEXT"><div name="-6316017" id="-6316017">“Agrosubsidiya” axborot tizimida maʼlumotlar bilan almashish uchun Moliya vazirligining Davlat imtiyozlari yagona elektron platformasi (subsidiya.mf.uz) va “UzASBO” dasturiy majmuasi hamda boshqa davlat boshqaruvi organlari va xoʻjalik birlashmalarining axborot tizimlari bilan oʻzaro integratsiyalashuvini amalga oshirish;</div></div><div class="ACT_TEXT"><div name="-6316019" id="-6316019">“Agrosubsidiya” axborot tizimi yordamida qishloq xoʻjaligi mahsulotlari yetishtiruvchilarni davlat tomonidan qoʻllab-quvvatlash va subsidiya olishga talabgorlarning (keyingi oʻrinlarda — talabgorlar) subsidiya berish toʻgʻrisidagi arizalari vakolatli davlat boshqaruvi organlari va xoʻjalik birlashmalari tomonidan koʻrib chiqilishi va ijroga yoʻnaltirilishini avtomatlashtirish;</div></div><div class="ACT_TEXT"><div name="-6316022" id="-6316022">“Agrosubsidiya” axborot tizimi orqali qishloq xoʻjaligi sohasida berilayotgan subsidiya toʻgʻrisida ochiq va shaffof statistika maʼlumotlarini hamda ularning yagona elektron arxivini shakllantirish.</div></div><div class="ACT_TEXT"><div name="-6316023" id="-6316023">4. Quyidagilarni nazarda tutuvchi “Qishloq xoʻjaligi mahsulotlarini yetishtiruvchilarga subsidiya berish” axborot tizimi toʻgʻrisidagi nizom <a href="https://lex.uz/ru/docs/-6315790#-6316044">1-ilovaga</a> muvofiq tasdiqlansin:</div></div><div class="ACT_TEXT"><div name="-6316024" id="-6316024">“Agrosubsidiya” axborot tizimidan foydalanish tartibi, tizim operatori, tizimdan foydalanuvchi talabgorlar hamda masʼul tashkilotlarning majburiyatlari va huquqlari;</div></div><div class="ACT_TEXT"><div name="-6316026" id="-6316026">talabgorlar tomonidan subsidiya ajratilishi belgilangan yoʻnalishlar boʻyicha manzilli roʻyxatga kirish va subsidiya olish uchun axborot tizimi orqali ariza yuborish tartibi;</div></div><div class="ACT_TEXT"><div name="-6316027" id="-6316027">subsidiya ajratilishi belgilangan yoʻnalishlar boʻyicha talabgorlardan tushgan arizalarning vakolatli davlat boshqaruvi organlari va xoʻjalik birlashmalari tomonidan koʻrib chiqilishi, hujjatlarni elektron shaklda yuritish hamda ariza boʻyicha xulosa berish tartibi.</div></div><div class="BY_DEFAULT"><div name="-7503445" id="-7503445"></div></div><div class="ACT_TEXT"><div name="-7503450" id="-7503450">5. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi, Suv xoʻjaligi vazirligi, Qishloq xoʻjaligi vazirligi huzuridagi Agrosanoatni rivojlantirish agentligi hamda Oʻzbekiston fermerlari kengashi “Agrosubsidiya” axborot tizimi orqali ushbu qarorga <a href="https://lex.uz/ru/docs/-6315790#-6316218">2-ilovada </a>keltirilgan roʻyxat boʻyicha qishloq xoʻjaligi mahsulotlarini yetishtiruvchilarga xolislik va shaffoflik tamoyillari asosida subsidiya berish choralarini koʻrsin.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7503456" id="-7503456">(5-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 23-apreldagi 255-sonli <a href="https://lex.uz/ru/docs/-7491334?ONDATE=23.04.2025 00#-7494209">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 23.04.2025-y., 09/25/255/0376-son)</div></div><div class="ACT_TEXT"><div name="-6316029" id="-6316029">6. Belgilansinki, 2022-yil 20-dekabrdan boshlab:</div></div><div class="ACT_TEXT"><div name="-6316030" id="-6316030">talabgorlar tomonidan paxta, don va dukkakli, sabzavot, kartoshka, poliz, moyli va ozuqabop ekinlar, dorivor oʻsimliklar va xoʻraki uzum mahsulotlarini yetishtirishda, mevali bogʻlar barpo qilishda hamda suvni tejaydigan texnologiyalarni joriy etish xarajatlarining bir qismini qoplash boʻyicha subsidiya olish uchun arizalar “Agrosubsidiya” axborot tizimi orqali yuboriladi;</div></div><div class="BY_DEFAULT"><div name="-7503458" id="-7503458"></div></div><div class="ACT_TEXT"><div name="-7503462" id="-7503462">talabgorlarning ushbu qarorga <a href="https://lex.uz/ru/docs/-6315790#-6316218">2-ilovada</a> keltirilgan roʻyxat boʻyicha subsidiya olish uchun taqdim etgan arizalari subsidiya berish yoʻnalishlariga muvofiq Qishloq xoʻjaligi vazirligi, Suv xoʻjaligi vazirligi, Qishloq xoʻjaligi vazirligi huzuridagi Agrosanoatni rivojlantirish agentligi hamda Oʻzbekiston fermerlari kengashining tuman, viloyat va respublika ishchi guruhlari tomonidan “Agrosubsidiya” axborot tizimi orqali qabul qilinadi, koʻrib chiqiladi va ijroga yoʻnaltiriladi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-7503468" id="-7503468">(6-bandning uchinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2025-yil 23-apreldagi 255-sonli <a href="https://lex.uz/ru/docs/-7491334?ONDATE=23.04.2025 00#-7494215">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 23.04.2025-y., 09/25/255/0376-son)</div></div><div class="ACT_TEXT"><div name="-6316032" id="-6316032">7. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi:</div></div><div class="ACT_TEXT"><div name="-6316033" id="-6316033">“Agrosubsidiya” axborot tizimini joriy etish maqsadida Qoraqalpogʻiston Respublikasi va viloyatlar boʻyicha davlat boshqaruvi organlari va xoʻjalik birlashmalari hamda dehqon, fermer xoʻjaliklari va klasterlar uchun doimiy ravishda “Agrosubsidiya” axborot tizimidan foydalanish boʻyicha mavzuli seminarlar tashkil etish choralarini koʻrsin;</div></div><div class="ACT_TEXT"><div name="-6316034" id="-6316034">manfaatdor vazirliklar va idoralar bilan birgalikda 2022-yil yakuniga qadar Qishloq xoʻjaligi vazirligining “Geoaxborot” tizimiga respublika boʻyicha joriy etilgan suvni tejaydigan texnologiyalar haqidagi maʼlumotlar xaritada joylashgan joyi va tegishli geoaxborot maʼlumotlari doimiy yangilangan holda kiritib borilishini taʼminlasin. </div></div><div class="ACT_TEXT"><div name="-6316035" id="-6316035">8. Qoraqalpogʻiston Respublikasi Vazirlar Kengashi, viloyatlar va Toshkent shahar, tumanlar (Quvasoy shahri) hokimliklari, tegishli vazirliklar va idoralar 2022-yil 20-dekabrga qadar subsidiya berish jarayonlarida ishtirok etuvchi barcha tashkilotlarni “Agrosubsidiya” axborot tizimiga ulash choralarini koʻrsin.</div></div><div class="ACT_TEXT"><div name="-6316036" id="-6316036">9. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi manfaatdor vazirliklar va idoralar bilan birgalikda oʻzlari qabul qilgan normativ-huquqiy hujjatlarni bir oy muddatda ushbu qarorga muvofiqlashtirsin.</div></div><div class="ACT_TEXT"><div name="-6316037" id="-6316037">10. Mazkur qarorning bajarilishini nazorat qilish Oʻzbekiston Respublikasi Bosh vazirining agrar va oziq-ovqat sohalarini rivojlantirish masalalari boʻyicha oʻrinbosari Sh.M. Gʻaniyev zimmasiga yuklansin.</div></div><div class="SIGNATURE"><div name="-6316038" id="-6316038">Oʻzbekiston Respublikasining Bosh vaziri A. ARIPOV</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6316041" id="-6316041">Toshkent sh.,</div></div><div class="ACT_ESSENTIAL_ELEMENTS"><div name="-6316042" id="-6316042">2022-yil 16-dekabr,</div></div><div class="ACT_ESSENTIAL_ELEMENTS_NUM"><div name="-6316043" id="-6316043">711-son</div></div><div class="BY_DEFAULT"><div name="-6316044" id="-6316044"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-6316045" id="-6316045">Vazirlar Mahkamasining 2022-yil 16-dekabrdagi 711-son <a href="https://lex.uz/ru/docs/-6315790">qaroriga</a> <br />1-ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-6316084" id="-6316084">“Qishloq xoʻjaligi mahsulotlarini ishlab chiqaruvchilarga subsidiya berish” axborot tizimi toʻgʻrisida</div></div><div class="ACT_FORM"><div name="-6316085" id="-6316085">NIZOM</div></div><div class="BY_DEFAULT"><div name="-6316086" id="-6316086"></div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316087" id="-6316087">1-bob. Umumiy qoidalar</div></div><div class="ACT_TEXT"><div name="-6316088" id="-6316088">1. Ushbu Nizom “Qishloq xoʻjaligi mahsulotlarini ishlab chiqaruvchilarga subsidiya berish” axborot tizimidan (keyingi oʻrinlarda — “Agrosubsidiya” axborot tizimi) foydalanish, shuningdek, “Agrosubsidiya” axborot tizimi orqali qishloq xoʻjaligi mahsulotlari ishlab chiqaruvchilarni davlat tomonidan qoʻllab-quvvatlash va subsidiya olishga talabgorlarning (keyingi oʻrinlarda — talabgorlar) arizalarini koʻrib chiqish va ularga subsidiya ajratish tartibini belgilaydi.</div></div><div class="ACT_TEXT"><div name="-6316089" id="-6316089">2. Mazkur Nizomda quyidagi asosiy tushunchalar qoʻllaniladi:</div></div><div class="ACT_TEXT"><div name="-6316090" id="-6316090"><strong>ariza</strong> — talabgorlar tomonidan manzilli roʻyxatga kirish va sarflangan xarajatlar bir qismini qoplash uchun subsidiya ajratish toʻgʻrisida taqdim etilgan elektron ariza;</div></div><div class="ACT_TEXT"><div name="-6316091" id="-6316091"><strong>axborot tizimi (AT)</strong> — axborotni toʻplash, saqlash, izlash, unga ishlov berish hamda undan foydalanish imkonini beradigan, tashkiliy jihatdan tartibga solingan axborot resurslari jamlanmasi, axborot texnologiyalari va aloqa vositalari;</div></div><div class="ACT_TEXT"><div name="-6316092" id="-6316092"><strong>axborot tizimi ishtirokchisi</strong> — talabgorlardan tushgan arizalarni koʻrib chiquvchi hamda ular boʻyicha xulosa beruvchi davlat boshqaruvi organlari va boshqa tashkilotlar, ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari;</div></div><div class="ACT_TEXT"><div name="-6316093" id="-6316093"><strong>axborot tizimi foydalanuvchisi</strong> — manzilli roʻyxatga kirish yoki subsidiya olish uchun ariza taqdim etgan talabgorlar;</div></div><div class="ACT_TEXT"><div name="-6316094" id="-6316094"><strong>vakolatli organlar</strong> — subsidiyalash xizmatlarini koʻrsatuvchi hamda subsidiya berish uchun masʼul boʻlgan davlat organlari va boshqa tashkilotlar;</div></div><div class="ACT_TEXT"><div name="-6316095" id="-6316095"><strong>manzilli roʻyxat</strong> — qishloq xoʻjaligi mahsulotlari ishlab chiqaruvchilarni qoʻllab-quvvatlash uchun ajratiladigan subsidiyalarni olish uchun qoʻyilgan talablar va ishlarni bajaruvchi talabgorlar roʻyxati;</div></div><div class="ACT_TEXT"><div name="-6316096" id="-6316096"><strong>ommaviy oferta</strong> — subsidiyalash xizmatlari orqali tizimdan foydalanish boʻyicha xizmat koʻrsatish shartnomasini tuzish yuzasidan talabgorlarga bildirilgan rasmiy taklif;</div></div><div class="ACT_TEXT"><div name="-6316097" id="-6316097"><strong>subsidiya</strong> — tovarlar ishlab chiqarish, ishlarni bajarish, xizmatlar koʻrsatish va ularni realizatsiya qilishni moliyalashtirish yoki birgalikda moliyalashtirish yoxud maqsadli xarajatlarning oʻrnini qisman qoplash uchun budjet tizimi budjetlari hisobidan yuridik va jismoniy shaxslarga beriladigan pul mablagʻlari;</div></div><div class="ACT_TEXT"><div name="-6316098" id="-6316098"><strong>talabgorlar</strong> — subsidiya olish uchun murojaat qilgan qishloq xoʻjaligi mahsulotlari yetishtiruvchilar;</div></div><div class="ACT_TEXT"><div name="-6316099" id="-6316099"><strong>talabgorni autentifikatsiyalash</strong> — avval identifikatsiya qilingan foydalanuvchidan real vaqt rejimida olingan dastlabki identifikatsiya maʼlumotlari bilan avtomatlashtirilgan holda (inson omilisiz) solishtirish orqali foydalanuvchining shaxsini tekshirish va tasdiqlash jarayoni;</div></div><div class="ACT_TEXT"><div name="-6316100" id="-6316100"><strong>tuman (Quvasoy shahri) ishchi guruhi</strong> — subsidiya ajratish yoʻnalishi boʻyicha vakolatli organlarga subsidiya ajratishga koʻmaklashuvchi, amaldagi normativ-huquqiy hujjatga muvofiq tuman davlat boshqaruvi hamda xoʻjalik birlashmalari vakillaridan iborat ishchi guruh;</div></div><div class="ACT_TEXT"><div name="-6316101" id="-6316101"><strong>foydalanuvchilarni identifikatsiyalash </strong>— shaxsiy maʼlumotlar yordamida foydalanuvchining shaxsini tasdiqlab, masofadan turib subsidiyalash xizmatlaridan foydalanish imkonini yaratuvchi mexanizm;</div></div><div class="ACT_TEXT"><div name="-6316102" id="-6316102"><strong>hududiy ishchi guruh</strong> — subsidiya ajratish yoʻnalishi boʻyicha vakolatli organlarga subsidiya ajratishga koʻmaklashuvchi, amaldagi normativ-huquqiy hujjatga muvofiq mahalliy davlat boshqaruvi organlari va boshqa tashkilotlar vakillaridan iborat ishchi guruh;</div></div><div class="ACT_TEXT"><div name="-6316103" id="-6316103"><strong>xulosa</strong> — vakolatli organlar tomonidan subsidiya ajratilishi maqsadga muvofiq yoki muvofiq emasligi haqida talabgorlarga yuboriladigan elektron (QR-kod biriktirilgan) hujjat;</div></div><div class="ACT_TEXT"><div name="-6316104" id="-6316104"><strong>elektron raqamli imzo</strong> — elektron hujjatdagi axborotni elektron raqamli imzoning yopiq kalitidan foydalangan holda maxsus oʻzgartirish natijasida hosil qilingan hamda elektron raqamli imzoning ochiq kaliti yordamida elektron hujjatdagi axborotda xatolik yoʻqligini aniqlash va elektron raqamli imzo yopiq kalitining egasini identifikatsiyalash imkonini beradigan imzo;</div></div><div class="ACT_TEXT"><div name="-6316105" id="-6316105"><strong>“Elektron hukumat” tizimi foydalanuvchilarni identifikatsiyalashning yagona axborot tizimi (id.egov.uz)</strong> — jismoniy va yuridik shaxslarning haqiqiy identifikatsiyalash, shuningdek, idoralararo elektron hamkorlikda mansabdor shaxslarning axborot tizimlari va maʼlumotlar bazalaridan ruxsat olib foydalanishini taʼminlovchi davlat axborot tizimi;</div></div><div class="ACT_TEXT"><div name="-6316106" id="-6316106"><strong>QR-kod</strong> — (matrik shtrixli kod) takrorlanmas boʻlib, uning ichiga ariza vakolatli organlar tomonidan koʻrib chiqilishi natijalari toʻgʻrisidagi elektron xulosalarga internet tarmogʻi orqali havola joylashtiriladi;</div></div><div class="ACT_TEXT"><div name="-6316107" id="-6316107"><strong>“UzASBO” DM</strong> — budjet tashkilotlari tomonidan budjet hisobi va hisoboti yuritilishini kompleks avtomatlashtirish uchun moʻljallangan dasturiy majmua.</div></div><div class="BY_DEFAULT"><div name="-6561458" id="-6561458"></div></div><div class="ACT_TEXT"><div name="-6561460" id="-6561460">3. Oʻzbekiston Respublikasi Qishloq xoʻjaligi vazirligi huzuridagi “Agrosanoatni raqamlashtirish markazi” MCHJ “Agrosubsidiya” ATning operatori hisoblanadi.</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-6561487" id="-6561487">(3-band Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2023-yil 3-avgustdagi 330-sonli <a href="https://lex.uz/ru/docs/-6556006?ONDATE=04.08.2023 00#-6558075">qarori</a> tahririda — Qonunchilik maʼlumotlari milliy bazasi, 04.08.2023-y., 09/23/330/0559-son)</div></div><div class="ACT_TEXT"><div name="-6316109" id="-6316109">4. “Agrosubsidiya” ATning asosiy vazifalari quyidagilardan iborat:</div></div><div class="ACT_TEXT"><div name="-6316110" id="-6316110">talabgorlar tomonidan subsidiya olish uchun arizalar elektron shaklda yuborilishini hamda ushbu xizmatdan xavfsiz va kafolatli foydalanishni taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6316111" id="-6316111">talabgorlarga ularning manzilli roʻyxatga kirishi yoki subsidiya olish uchun yuborilgan arizalarni koʻrib chiqishning holatini va bosqichlarni koʻrib borish imkoniyatini yaratish;</div></div><div class="ACT_TEXT"><div name="-6316112" id="-6316112">talabgorlarga ular tomonidan yuborilgan arizalar vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar tomonidan koʻrib chiqilishi natijalarini (xulosalar) kuzatib borishni taʼminlash;</div></div><div class="ACT_TEXT"><div name="-6316113" id="-6316113">vakolatli organlar tomonidan talabgorlar yuborgan arizalarni koʻrib chiqish va ularga elektron shaklda xulosa berish.</div></div><div class="ACT_TEXT"><div name="-6316114" id="-6316114">5. Qonunchilik hujjatlariga muvofiq qishloq xoʻjaligi mahsulotlari yetishtiruvchilarni qoʻllab-quvvatlash uchun subsidiyalar “Agrosubsidiya” axborot tizimi orqali beriladi.</div></div><div class="ACT_TEXT"><div name="-6316115" id="-6316115">6. “Agrosubsidiya” axborot tizimi orqali beriladigan subsidiya turlariga qishloq xoʻjaligi mahsulotlari yetishtiruvchilarni qoʻllab-quvvatlash uchun beriladigan subsidiyalarni ajratish bilan bogʻliq qonunchilik hujjatlari qabul qilinishi munosabati bilan qoʻshimchalar kiritib borilishi mumkin.</div></div><div class="ACT_TEXT"><div name="-6316116" id="-6316116">7. Yangi turdagi subsidiyalarni “Agrosubsidiya” axborot tizimi orqali berish Qishloq xoʻjaligi vazirligi, axborot tizimi operatori hamda vakolatli davlat organlari oʻrtasidagi kelishuv asosida amalga oshiriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316117" id="-6316117">2-bob. “Agrosubsidiya” axborot tizimi orqali arizani yuborish tartibi</div></div><div class="ACT_TEXT"><div name="-6316118" id="-6316118">8. Talabgorlarni “Agrosubsidiya” axborot tizimida foydalanuvchi sifatida roʻyxatga olish, identifikatsiyalash va autentifikatsiyalash “Elektron hukumat” tizimi foydalanuvchilarini identifikatsiyalashning yagona axborot tizimi (id.egov.uz) orqali amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-6316119" id="-6316119">9. Manzilli roʻyxatga kirish uchun ariza yuborishda:</div></div><div class="ACT_TEXT"><div name="-6316120" id="-6316120">talabgorlar “Agrosubsidiya” axborot tizimida koʻrsatilgan ommaviy oferta bilan tanishgan holda shaxsiga doir maʼlumotlarni qayta ishlash orqali subsidiyalash xizmatlaridan foydalanishga rozilik bildiradi yoki rad etadi;</div></div><div class="BY_DEFAULT"><div name="-8342964" id="-8342964"></div></div><div class="ACT_TEXT"><div name="-8342965" id="-8342965">talabgorlar arizani Oʻzbekiston Respublikasi Yagona interaktiv davlat xizmatlari portali (keyingi oʻrinlarda — YIDXP) yoki “Raqamli qishloq xoʻjaligi” yagona integratsion platformasi (keyingi oʻrinlarda — Agroportal) yoxud bevosita “Agrosubsidiya” axborot tizimiga kirish orqali yuboradi. Talabgorlar arizani qonunchilik hujjatlarida nazarda tutilgan va axborot tizimida joylashtirilgan shaklga muvofiq toʻldirgan holda elektron shaklda yuboradi. Bunda ariza bilan murojaat qilganlik hamda arizaning vakolatli davlat organlari va boshqa tashkilotlar tomonidan koʻrib chiqilganligi uchun toʻlov undirilmaydi;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8342966" id="-8342966">(9-bandning uchinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 13-iyuldagi 381-sonli <a href="https://lex.uz/ru/docs/-8327588?ONDATE=15.07.2026 00#-8328357">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 15.07.2026-y., 09/26/381/0734-son)</div></div><div class="ACT_TEXT"><div name="-6316122" id="-6316122">talabgor ariza bilan birga taqdim etilgan hujjatlar va ularda koʻrsatilgan maʼlumotlarning ishonchliligi va haqqoniyligi uchun shaxsan javobgar hisoblanadi hamda arizani elektron raqamli imzosi orqali tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6316123" id="-6316123">“Agrosubsidiya” axborot tizimiga kelib tushgan har bir arizaga noyob raqam (identifikatsiya raqami) raqami biriktiriladi;</div></div><div class="ACT_TEXT"><div name="-6316124" id="-6316124">talabgorlarga ular tomonidan yuborilgan arizaning holati haqidagi maʼlumot “Agrosubsidiya” axborot tizimiga arizaning noyob raqami kiritilishi orqali yoki talabgorlarning axborot tizimidagi shaxsiy kabineti orqali taqdim etiladi;</div></div><div class="ACT_TEXT"><div name="-6316125" id="-6316125">talabgorlar yuborgan ariza vakolatli organlar tomonidan qonunchilik hujjatlari talablari va muddatlariga muvofiq koʻrib chiqiladi;</div></div><div class="ACT_TEXT"><div name="-6316126" id="-6316126">arizalarni koʻrib chiqish natijasi boʻyicha xulosa subsidiya turiga qarab qonunchilik hujjatlarga muvofiq rasmiylashtiriladi;</div></div><div class="ACT_TEXT"><div name="-6316127" id="-6316127">ariza oʻz vaqtida koʻrib chiqilmaganda, muddatidan oʻtgan ariza haqidagi xabarnomalar “Agrosubsidiya” axborot tizimida subsidiyalash xizmatlari joriy qilingan vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar shaxsiy kabinetlarida aks ettiriladi va monitoringi olib boriladi. </div></div><div class="ACT_TEXT"><div name="-6316128" id="-6316128">10. Subsidiya olish uchun ariza yuborishda:</div></div><div class="ACT_TEXT"><div name="-6316129" id="-6316129">talabgorlar “Agrosubsidiya” ATda koʻrsatilgan ommaviy oferta bilan tanishgan holda shaxsiga doir maʼlumotlarni qayta ishlash orqali subsidiyalash xizmatlaridan foydalanishga rozilik bildiradi yoki rad etadi;</div></div><div class="BY_DEFAULT"><div name="-8342967" id="-8342967"></div></div><div class="ACT_TEXT"><div name="-8342968" id="-8342968">talabgorlar normativ-huquqiy hujjatlar talabidan kelib chiqib subsidiya ajratish uchun arizani qonunchilik hujjatlarida keltirilgan va “Agrosubsidiya” ATda joylashtirilgan shakl asosida toʻldirgan holda YIDXP yoki Agroportal yoxud bevosita “Agrosubsidiya” ATga kirish orqali elektron shaklda yuboradi. Bunda talabgorlar tomonidan ariza yuborish hamda vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar tomonidan ariza koʻrib chiqilishi uchun toʻlov undirilmaydi;</div></div><div class="CHANGES_ORIGINS"><label id="s1104"></label><div name="-8342969" id="-8342969">(10-bandning uchinchi xatboshisi Oʻzbekiston Respublikasi Vazirlar Mahkamasining 2026-yil 13-iyuldagi 381-sonli <a href="https://lex.uz/ru/docs/-8327588?ONDATE=15.07.2026 00#-8328358">qarori </a>tahririda — Qonunchilik maʼlumotlari milliy bazasi, 15.07.2026-y., 09/26/381/0734-son)</div></div><div class="ACT_TEXT"><div name="-6316131" id="-6316131">talabgorlar ariza yuborish jarayonida taqdim etilgan hujjatlar va ularda koʻrsatilgan maʼlumotlarning ishonchliligi va haqqoniyligi uchun shaxsan javobgar hisoblanadi hamda arizani elektron raqamli imzosi orqali tasdiqlaydi;</div></div><div class="ACT_TEXT"><div name="-6316132" id="-6316132">tizimga kelib tushgan har bir arizaga noyob raqam (identifikatsiya raqami) biriktiriladi;</div></div><div class="ACT_TEXT"><div name="-6316133" id="-6316133">talabgorlarga ular tomonidan yuborilgan arizaning holati haqidagi maʼlumot “Agrosubsidiya” ATga arizaning noyob raqami kiritilishi orqali yoki talabgorlarning axborot tizimidagi shaxsiy kabineti orqali taqdim etiladi;</div></div><div class="ACT_TEXT"><div name="-6316134" id="-6316134">talabgorlar yuborgan ariza vakolatli organlar tomonidan qonunchilik hujjatlari talablariga muvofiq va ularda belgilangan muddatlarda koʻrib chiqiladi;</div></div><div class="ACT_TEXT"><div name="-6316135" id="-6316135">talabgorlar arizasini koʻrib chiqish natijasi boʻyicha xulosa subsidiya turiga qarab qonunchilik hujjatlariga muvofiq rasmiylashtiriladi;</div></div><div class="ACT_TEXT"><div name="-6316136" id="-6316136">subsidiya berish toʻgʻrisidagi xulosa shakli subsidiya turiga qarab qonunchilik hujjatlari bilan belgilangan shaklda maxsus QR-kod bilan tasdiqlangan holda rasmiylashtiriladi;</div></div><div class="ACT_TEXT"><div name="-6316137" id="-6316137">talabgorning arizasi oʻz vaqtida koʻrib chiqilmagan taqdirda, muddatidan oʻtgan arizalar haqidagi xabarnomalar “Agrosubsidiya” ATda subsidiyalash xizmatlari joriy qilingan vakolatli organlarning shaxsiy kabinetlarida aks ettiriladi va monitoringi olib boriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316138" id="-6316138">3-bob. “Agrosubsidiya” axborot tizimi orqali tushgan arizalarni koʻrib chiqish va xulosa berish tartibi</div></div><div class="ACT_TEXT"><div name="-6316139" id="-6316139">11. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning tuman (Quvasoy shahri) hududiy ishchi guruhlari aʼzolariga “Elektron hukumat” tizimi foydalanuvchilarini identifikatsiyalashning yagona axborot tizimi (id.egov.uz)da roʻyxatga olingan maʼlumotlari (login) asosida tizim operatori tomonidan axborot tizimidagi tegishli vakolatlari belgilanadi.</div></div><div class="ACT_TEXT"><div name="-6316140" id="-6316140">12. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari aʼzolariga “Agrosubsidiya” axborot tizimidagi tegishli vakolatlarni belgilash uchun tizim operatoriga ishchi guruhlar aʼzolarining “id.egov.uz” tizimidagi maʼlumotlari (loginni) <a href="https://lex.uz/ru/docs/-6315790#-6316204">ilova </a>qilingan holda rasmiy ravishda murojaat etiladi.</div></div><div class="ACT_TEXT"><div name="-6316141" id="-6316141">13. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari aʼzolari talabgorlar tomonidan yuborilgan arizani “Agrosubsidiya” axborot tizimi orqali qabul qiladi, subsidiya turidan kelib chiqib amaldagi normativ-huquqiy hujjatlar bilan belgilangan talab, muddat va bosqichlarga muvofiq koʻrib chiqadi.</div></div><div class="ACT_TEXT"><div name="-6316142" id="-6316142">14. Talabgorlar tomonidan yuborilgan arizaga xulosa vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari aʼzolari tomonidan elektron raqamli imzo bilan tasdiqlangan holda taqdim etiladi. Subsidiya ajratish toʻgʻrisidagi xulosa shakli subsidiya turiga qarab qonunchilik hujjatlarida belgilangan shakldagi maxsus QR-kod bilan tasdiqlangan holda rasmiylashtiriladi.</div></div><div class="ACT_TEXT"><div name="-6316143" id="-6316143">15. Talabgorlarning arizasini koʻrib chiqish natijasi boʻyicha xulosa subsidiya turiga qarab qonunchilik hujjatlarida belgilangan tarkibdagi ishchi guruhlarning qaror qabul qiluvchi asosiy aʼzolari tomonidan elektron raqamli imzo bilan tasdiqlangan holda rasmiylashtiriladi.</div></div><div class="ACT_TEXT"><div name="-6316144" id="-6316144">16. Talabgorlarning arizasini vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari tomonidan koʻrib chiqish jarayonlari va talablarning barcha bosqichlari amalga oshirilgandan soʻng subsidiya turiga qarab qonunchilik hujjatlariga hamda quyidagi ariza turlariga muvofiq:</div></div><div class="ACT_TEXT"><div name="-6316145" id="-6316145"><strong>manzilli roʻyxatga kirish uchun ariza</strong> — subsidiya ajratish maqsadida budjet parametrlarida inobatga olish uchun Oʻzbekiston Respublikasi Moliya vazirligiga “Agrosubsidiya” axborot tizimi orqali viloyatlar, Toshkent shahri, tumanlar (Quvasoy shahri) boʻyicha avtomatik tarzda shakllantirilgan holda taqdim etiladi;</div></div><div class="ACT_TEXT"><div name="-6316146" id="-6316146"><strong>subsidiya olish uchun ariza</strong> — subsidiya turiga qarab qonunchilik hujjatlarida belgilangan moliyalashtirish manbaidan kelib chiqqan holda subsidiya mablagʻlarini ajratish uchun “Agrosubsidiya” axborot tizimi orqali vakolatli davlat boshqaruvi organlari va boshqa tashkilotlarga kiritiladi.</div></div><div class="ACT_TEXT"><div name="-6316147" id="-6316147">17. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar talabgorlarning tijorat banklaridagi hisobvaragʻiga subsidiyani “UzASBO” dasturiy majmuasi orqali oʻtkazib beradi.</div></div><div class="ACT_TEXT"><div name="-6316148" id="-6316148">18. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar tomonidan subsidiya berish muddati subsidiya berish tartibini belgilovchi qonunchilik hujjatlarida belgilangan muddatlarda amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-6316151" id="-6316151">19. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda talabgorlar oʻrtasidagi shartnoma tegishli qonunchilik hujjatlarida belgilangan hollarda elektron raqamli imzo orqali imzolanadi.</div></div><div class="ACT_TEXT"><div name="-6316152" id="-6316152">20. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlarining talabgorlar tomonidan yuborilgan arizalarni koʻrib chiqish natijasi boʻyicha xulosasi subsidiya turiga qarab qonunchilik hujjatlarida belgilangan har bir bosqichga muvofiq talabgorlarning shaxsiy kabinetida aks ettiriladi.</div></div><div class="ACT_TEXT"><div name="-6316153" id="-6316153">21. “Agrosubsidiya” AT orqali ariza yuborish va koʻrib chiqish jarayonlari ushbu Nizomga <a href="https://lex.uz/ru/docs/-6315790#-6316204">ilovada</a> keltirilgan sxemaga muvofiq amalga oshiriladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316154" id="-6316154">4-bob. Subsidiya ajratilishini monitoring qilish </div></div><div class="ACT_TEXT"><div name="-6316155" id="-6316155">22. Vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar tomonidan talabgorlarning tijorat banklaridagi hisobvaragʻiga subsidiya oʻz vaqtida oʻtkazib berilishini monitoring qilish jarayoni axborot tizimida “UzASBO” dasturiy majmuasi orqali axborot almashish yoʻli bilan amalga oshiriladi.</div></div><div class="ACT_TEXT"><div name="-6316156" id="-6316156">23. Subsidiya berish haqidagi xabar talabgorlarning shaxsiy kabinetida aks ettiriladi.</div></div><div class="ACT_TEXT"><div name="-6316157" id="-6316157">24. Talabgor tomonidan subsidiya ajratilishida belgilangan talablar buzilganda vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar subsidiya berish talablari buzilishi sababli qaytarilgan subsidiya mablagʻlari boʻyicha maʼlumotlar “Agrosubsidiya” axborot tizimiga kiritib borilishini taʼminlaydi.</div></div><div class="ACT_TEXT"><div name="-6316158" id="-6316158">25. Monitoring natijalariga koʻra talabgorlarning arizasi oʻz vaqtida koʻrib chiqilmagan taqdirda, subsidiyalash xizmatlarini koʻrsatuvchi vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlari aʼzolariga qonunchilikda belgilangan tartibda intizomiy taʼsir choralari qoʻllaniladi.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316161" id="-6316161">5-bob. “Agrosubsidiya” axborot tizimi operatori hamda ishtirokchisining huquqlari va majburiyatlari</div></div><div class="ACT_TEXT"><div name="-6316164" id="-6316164">26. “Agrosubsidiya” AT operatori quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-6316166" id="-6316166">axborot tizimiga kirish va undan foydalanish tartibini belgilash;</div></div><div class="ACT_TEXT"><div name="-6316167" id="-6316167">axborot almashish uchun belgilangan tartibda “Agrosubsidiya” axborot tizimining boshqa axborot tizimlari bilan integratsiyalashuvni amalga oshirish.</div></div><div class="ACT_TEXT"><div name="-6316168" id="-6316168">27. “Agrosubsidiya” axborot tizimi operatori:</div></div><div class="ACT_TEXT"><div name="-6316171" id="-6316171">qonunchilik hujjatlariga kiritilgan oʻzgartirishlar asosida tizimni doimiy ravishda takomillashtirib borishi;</div></div><div class="ACT_TEXT"><div name="-6316176" id="-6316176">manfaatdor davlat organlari va tashkilotlari bilan birgalikda tizim modullari ularning axborot tizimlariga integratsiyalashtirishi;</div></div><div class="ACT_TEXT"><div name="-6316178" id="-6316178">tizimning uzluksiz ishlashini va axborot xavfsizligini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6316179" id="-6316179">vakolatli davlat boshqaruvi organlari va tashkilotlarni hamda tizim foydalanuvchilarini tizimning texnik nosozliklari toʻgʻrisida oʻz vaqtida xabardor qilishi;</div></div><div class="ACT_TEXT"><div name="-6316180" id="-6316180">vakolatli davlat boshqaruvi organlari va boshqa tashkilotlar hamda ularning hududiy, tuman (Quvasoy shahri) ishchi guruhlarining aʼzolariga tizimdan foydalanish uchun sharoitlar yaratib berishi lozim.</div></div><div class="ACT_TEXT"><div name="-6316181" id="-6316181">“Agrosubsidiya” axborot tizimiga qonunchilik hujjatlariga muvofiq boshqa majburiyatlar ham yuklanishi mumkin.</div></div><div class="ACT_TEXT"><div name="-6316182" id="-6316182">28. Axborot tizimi ishtirokchisi quyidagi huquqlarga ega:</div></div><div class="ACT_TEXT"><div name="-6316183" id="-6316183">tizimdan mazkur Nizom talablari doirasida foydalanish;</div></div><div class="ACT_TEXT"><div name="-6316184" id="-6316184">tizim operatoriga subsidiya ajratish jarayonlarini maqbullashtirish boʻyicha takliflar kiritish;</div></div><div class="ACT_TEXT"><div name="-6316186" id="-6316186">zarur hollarda talabgorlarga taalluqli qoʻshimcha maʼlumotlarni tuman ishchi guruhlaridan talab qilish.</div></div><div class="ACT_TEXT"><div name="-6316187" id="-6316187">29. Axborot tizimi ishtirokchisi:</div></div><div class="ACT_TEXT"><div name="-6316188" id="-6316188">shaxsga doir maʼlumotlarni tarqatmasligi va ularni muhofaza qilish boʻyicha zarur chora-tadbirlarni oʻz vaqtida amalga oshirishi;</div></div><div class="ACT_TEXT"><div name="-6316191" id="-6316191">talabgorlar xarajatlarining bir qismini qoplash uchun ajratiladigan subsidiyalar belgilangan muddatlarda “UzASBO” dasturiy majmuasi orqali talabgorlarning hisobvaragʻiga oʻtkazib berilishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6316192" id="-6316192">talabgorlarga subsidiya ajratilishi maqsadga muvofiqligi yoki maqsadga muvofiq emasligi yuzasidan xulosalar qonunchilik hujjatlarida belgilangan muddatlarda taqdim etilishini taʼminlashi;</div></div><div class="ACT_TEXT"><div name="-6316193" id="-6316193">talabgorlardan tushgan savol va eʼtirozlarni koʻrib chiqish va javob yoʻllash uchun masʼul xodimlarni ajratishi shart.</div></div><div class="TEXT_HEADER_DEFAULT"><div name="-6316194" id="-6316194">6-bob. Yakunlovchi qoidalar</div></div><div class="ACT_TEXT"><div name="-6316196" id="-6316196">30. “Agrosubsidiya” axborot tizimi orqali taqdim etiladigan subsidiyalar va ularni taqdim etish uchun asos boʻlgan qonunchilik hujjatlari boʻyicha maʼlumotlar axborot tizimining “Normativ-huquqiy hujjatlar” boʻlimida joylashtirib boriladi.</div></div><div class="ACT_TEXT"><div name="-6316197" id="-6316197">31. Subsidiya ajratishda yuzaga keladigan nizolar va kelishmovchiliklar qonunchilikda belgilangan tartibda hal qilinadi.</div></div><div class="ACT_TEXT"><div name="-6316198" id="-6316198">32. Ushbu Nizom talablari buzilishida aybdor boʻlgan shaxslar qonunchilik hujjatlarida belgilangan tartibda javob beradilar.</div></div><div class="BY_DEFAULT"><div name="-6316204" id="-6316204"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><div name="-6316208" id="-6316208">“Qishloq xoʻjaligi mahsulotlarini ishlab chiqaruvchilarga subsidiya berish” axborot tizimi toʻgʻrisidagi <a href="https://lex.uz/ru/docs/-6315790#-6316084">nizomga</a> <br />ILOVA </div></div><div class="ACT_TITLE_APPL"><div name="-6316212" id="-6316212">“Qishloq xoʻjaligi mahsulotlarini ishlab chiqaruvchilarga subsidiya berish” axborot tizimi orqali arizalarni yuborish, koʻrib chiqish va xulosa berish</div></div><div class="ACT_FORM"><div name="-6316213" id="-6316213">SXEMASI</div></div><div class="BY_DEFAULT"><div name="-6316214" id="-6316214"></div></div><div class="BY_DEFAULT"><div name="-6316215" id="-6316215"><table style="BORDER-COLLAPSE: collapse" border="0" cellspacing="0" cellpadding="0" width="100%">
<tbody>
<tr style="HEIGHT: 14.2pt">
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: windowtext 1pt solid;PADDING-BOTTOM: 0cm;PADDING-LEFT: 2.85pt;PADDING-RIGHT: 2.85pt;HEIGHT: 14.2pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" rowspan="2" width="8%">
<p style="TEXT-ALIGN: center" align="center"><b><span>Bosqichlar</span></b></p></td>
<td style="BORDER-BOTTOM: #f0f0f0;BORDER-LEFT: #f0f0f0;PADDING-BOTTOM: 0cm;PADDING-LEFT: 2.85pt;PADDING-RIGHT: 2.85pt;HEIGHT: 14.2pt;BORDER-TOP: #f0f0f0;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="1%">
<p style="TEXT-ALIGN: center" align="center"><b></b></p></td>
<td style="BORDER-BOTTOM: windowtext 1pt solid;BORDER-LEFT: #f0f0f0;PADDING-BOTTOM: 0cm;PADDING-LEFT: 2.85pt;PADDING-RIGHT: 2.85pt;HEIGHT: 14.2pt;BORDER-TOP: windowtext 1pt solid;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" rowspan="2" width="22%">
<p style="TEXT-ALIGN: center" align="center"><b><span>Subyektlar</span></b></p></td>
<td style="BORDER-BOTTOM: #f0f0f0;BORDER-LEFT: #f0f0f0;PADDING-BOTTOM: 0cm;PADDING-LEFT: 2.85pt;PADDING-RIGHT: 2.85pt;HEIGHT: 14.2pt;BORDER-TOP: #f0f0f0;BORDER-RIGHT: windowtext 1pt solid;PADDING-TOP: 0cm" width="1%">
